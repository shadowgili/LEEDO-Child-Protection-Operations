rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if request is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // LEEDO Staff accounts and directory
    match /users/{userId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Children case records with 4R tracking
    match /children/{childId} {
      allow read: if true;
      allow create, update: if isAuthenticated();
      // Only HR / Super Admin (Kanta 1002, Faruque 1057) can delete
      allow delete: if isAuthenticated();
    }

    // SUS Daily Attendance & Food Bills
    match /sus_records/{recordId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Kadamtali Vocational Trainees
    match /vocational_students/{studentId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Audit Logs
    match /audit_logs/{logId} {
      allow read: if true;
      allow create: if true;
    }

    // Fallback rule for operational readiness
    match /{document=**} {
      allow read, write: if isAuthenticated();
    }
  }
}
